# Скопируйте в .env и заполните. Строки с # не читаются.

# Ключ Claude API: https://platform.claude.com/ → API keys
ANTHROPIC_API_KEY=sk-ant-...

# Модель для протокола (по умолчанию claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5
# Глубина проработки: low | medium | high | xhigh
# CLAUDE_EFFORT=high

# Модель распознавания речи: tiny, base, small, medium, large-v3.
# medium — хороший русский на обычном компьютере; large-v3 точнее, но вдвое медленнее.
# WHISPER_MODEL=medium
# Устройство: auto | cpu | cuda
# WHISPER_DEVICE=auto
# Куда скачивать модели (по умолчанию кэш Hugging Face в домашней папке)
# WHISPER_DOWNLOAD_ROOT=./models

# Язык речи по умолчанию
# MEETING_LANGUAGE=ru

# Адрес и порт веб-интерфейса
# MEETING_HOST=127.0.0.1
# MEETING_PORT=8787
# Папка с загруженными записями и результатами
# MEETING_DATA_DIR=./data
# MEETING_MAX_UPLOAD_MB=2048
